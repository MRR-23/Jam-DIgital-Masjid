rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mosque settings document
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Realtime murattal progress
    match /murattal_progress/{progressId} {
      allow read: if true;
      allow write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
